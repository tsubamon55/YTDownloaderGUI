.venv/

# PyInstaller build artifacts
build/
dist/

# Inno Setup build output
installer_output/

# Bundled ffmpeg binaries (large, fetched separately - see README)
ffmpeg/

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.idea/

# アプリのデバッグログ(paths.log_debug)はOSごとのアプリデータフォルダのcrash.logへ書かれる。
# 調査のためにプロジェクト直下へコピーしたものを誤ってコミットしないよう除外する
crash.log

# macOSビルド時に生成するアイコン(README「アプリアイコン」/ release.yml参照)
downloader-icon/*.icns
downloader-icon/*.iconset/
